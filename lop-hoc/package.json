{
  "name": "lop-hoc",
  "version": "1.0.0",
  "private": true,
  "description": "Lớp học \"Ai thông minh hơn\" cho TikTok LIVE: chat VÀO để vào lớp, comment A B C D để trả lời, ba bạn cao điểm nhất làm ban cán sự",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test tests/*.test.js",
    "window": "start \"\" msedge --app=http://127.0.0.1:3008/ --window-size=456,820 --window-position=0,0 --user-data-dir=D:\\tiktok-cache\\lop-hoc-window --disable-component-update --no-first-run --no-default-browser-check --autoplay-policy=no-user-gesture-required --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-background-timer-throttling --disable-features=CalculateNativeWinOcclusion"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "express": "^5.3.0",
    "tiktok-live-connector": "^2.5.0"
  }
}
